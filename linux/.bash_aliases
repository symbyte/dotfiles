alias "glog"="git lg3"
alias "gs"="git status"
alias "gc"="git commit"
alias "gf"="git fetch --prune"
alias "gpl"="git pull"
alias "gp"="git push"
alias "ga"="git add"
alias "gam"="git commit -a --amend --no-edit"
alias "gch"="git checkout"
alias "gr"="git rebase"

alias "open"="cmd.exe /C start"
alias "emacs"="emacs -a ''"
alias "chrome"="/mnt/c/Program\ Files\ \(x86\)/Google/Chrome/Application/chrome.exe"
